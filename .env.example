# -----------------------------------------------------------------------------
# Google Reviews — official Google Places API (New)
# -----------------------------------------------------------------------------
# Enable Places API (New) and restrict the API key to your server.
# https://developers.google.com/maps/documentation/places/web-service/place-details
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional: override the "Read all reviews" destination.
# GOOGLE_REVIEWS_URL=https://search.google.com/local/reviews?placeid=...

# -----------------------------------------------------------------------------
# Instagram Feed — official Instagram Graph API
# -----------------------------------------------------------------------------
# Requires an Instagram Business/Creator account connected to a Facebook Page.
# https://developers.facebook.com/docs/instagram-api/guides/business-discovery
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0

# Optional fallback shown before the account is connected.
# INSTAGRAM_USERNAME=nunchisalon

# -----------------------------------------------------------------------------
# Offers manager (/admin/offers)
# -----------------------------------------------------------------------------
# Choose a strong password. The manager is disabled until this is set.
ADMIN_PASSWORD=
# Optional but recommended: a long random string used to sign the admin cookie.
ADMIN_SESSION_SECRET=

# Optional: writable JSON path for offers. Defaults to ./data/offers.json.
# On serverless platforms, point this at a persistent volume or replace the
# repository in src/lib/offers.ts with your database/CMS adapter.
# OFFERS_FILE=/var/data/nunchi-offers.json
